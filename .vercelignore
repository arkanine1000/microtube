# Build artifacts — regenerated by scripts/vercel-build.sh.
target
node_modules
apps/web/dist
apps/web/public/microtube-worklet/wasm
apps/web/public/microtube-worklet/processor.js

# Note: crates/cli is intentionally kept — the Cargo workspace manifest
# lists it as a member, so cargo/wasm-pack need it present even though the
# web build only compiles crates/core.
